{
  "name": "mhz-tools",
  "version": "2.0.0",
  "description": "MHZ Tools 2.0 - Security, Cryptography, Data Analysis, Malware Static Analysis, C/C++ Architecture Converter, and Digital Forensics Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --win --linux"
  },
  "keywords": [
    "security",
    "cryptography",
    "malware-analysis",
    "digital-forensics",
    "data-analysis",
    "cpp-converter",
    "utilities"
  ],
  "author": {
    "name": "Mohammad Hussain Alzaghameem",
    "email": "mohzag615@gmail.com",
    "url": "https://mohammadzag.github.io/Portofolio/"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^22.3.25",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.mhz.tools",
    "productName": "MHZTools 2.0",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "synopsis": "MHZ Tools 2.0 - Security, Data Analysis & Digital Forensics Suite",
      "description": "Comprehensive client-side security, cryptography, data analysis, malware static analysis, C/C++ architecture conversion, and digital forensics suite.",
      "executableName": "mhztools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MHZ Tools"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "analysis.js",
      "main.js",
      "preload.js",
      "analysis.py",
      "crypto-js.js",
      "plotly.min.js",
      "xlsx.full.min.js",
      "profile_avatar.jpg",
      "qrious.js",
      "malware.js",
      "lucide.min.js",
      "cpp_converter.js",
      "forensics.js"
    ],
    "asar": true,
    "asarUnpack": [
      "analysis.py",
      "plotly.min.js"
    ]
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "plotly.js-dist-min": "^3.7.0",
    "qrious": "^4.0.2",
    "xlsx": "^0.18.5"
  }
}
